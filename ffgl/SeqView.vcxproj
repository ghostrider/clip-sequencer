<?xml version="1.0" encoding="utf-8"?>
<!--
  SeqView FFGL source plugin (ffgl/): lives outside the FFGL SDK submodule (external/ffgl, pinned) and pulls the
  SDK sources in by relative path (same sources, glew.props, FFGLPlugins.def as the SDK's own
  build/windows/*.vcxproj files). stb headers: third_party/stb.
  Build: msbuild SeqView.vcxproj /p:Configuration=Release /p:Platform=x64
  Build + install in one step: build_seqview.ps1
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{24B764AB-ED04-43AB-B204-BAD279FC9B89}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>SeqView</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <FFGLRoot>$(MSBuildThisFileDirectory)..\external\ffgl\</FFGLRoot>
    <StbRoot>$(MSBuildThisFileDirectory)..\third_party\stb\</StbRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>MultiByte</CharacterSet>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(FFGLRoot)deps\glew.props" />
  </ImportGroup>
  <PropertyGroup>
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>SeqView</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(FFGLRoot)source\lib\;$(StbRoot);$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;SEQVIEW_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Link>
      <ModuleDefinitionFile>$(FFGLRoot)build\windows\FFGLPlugins.def</ModuleDefinitionFile>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <SubSystem>Windows</SubSystem>
      <ImportLibrary>$(OutDir)$(TargetName).lib</ImportLibrary>
      <AdditionalDependencies>OpenGL32.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <!-- SDK sources. Deliberately not source\lib\FFGLSDK.cpp: that is a unity file that #includes all of these. -->
  <ItemGroup>
    <ClCompile Include="$(FFGLRoot)source\lib\ffgl\*.cpp" />
    <ClCompile Include="$(FFGLRoot)source\lib\ffglex\*.cpp" />
    <ClCompile Include="$(FFGLRoot)source\lib\ffglquickstart\*.cpp" />
    <ClCompile Include="SeqView.cpp" />
    <ClCompile Include="SeqViewClient.cpp" />
    <ClCompile Include="SeqViewModel.cpp" />
    <ClCompile Include="SeqViewRender.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="SeqView.h" />
    <ClInclude Include="SeqViewParams.h" />
    <ClInclude Include="SeqViewClient.h" />
    <ClInclude Include="SeqViewModel.h" />
    <ClInclude Include="SeqViewRender.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="SeqView.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
    <None Include="build_seqview.ps1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    Build info (M11 Phase E), the same values as the app's build.rs: version from [workspace.package] in
    ../Cargo.toml (one version source), build number = git commit count, short commit (+ "-dirty"), UTC build
    date. Without git: build 0, commit "unknown". Writes BuildInfo.h into the intermediate directory before
    compiling; SeqView.cpp (About text, "Build" parameter) and SeqView.rc (DLL version resource) include it.
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="ClCompile;ResourceCompile">
    <PropertyGroup>
      <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepoRoot>
      <BuildInfoHeader>$(IntDir)BuildInfo.h</BuildInfoHeader>
      <!-- Cargo.toml must not contain a single quote: it is embedded in the quoted Regex argument below. -->
      <CargoToml>$([System.IO.File]::ReadAllText('$(RepoRoot)\Cargo.toml'))</CargoToml>
      <SeqVersion>$([System.Text.RegularExpressions.Regex]::Match('$(CargoToml)', '\[workspace\.package\][^\[]*?\nversion = "(\d+)\.(\d+)\.(\d+)"').Value)</SeqVersion>
    </PropertyGroup>
    <Error Condition="'$(SeqVersion)' == ''" Text="No version in [workspace.package] of $(RepoRoot)\Cargo.toml" />
    <PropertyGroup>
      <SeqVersion>$([System.Text.RegularExpressions.Regex]::Match('$(SeqVersion)', '(\d+)\.(\d+)\.(\d+)').Value)</SeqVersion>
      <SeqVersionMajor>$([System.Text.RegularExpressions.Regex]::Match('$(SeqVersion)', '^\d+').Value)</SeqVersionMajor>
      <SeqVersionMinor>$([System.Text.RegularExpressions.Regex]::Match('$(SeqVersion)', '(?&lt;=^\d+\.)\d+').Value)</SeqVersionMinor>
      <SeqVersionPatch>$([System.Text.RegularExpressions.Regex]::Match('$(SeqVersion)', '\d+$').Value)</SeqVersionPatch>
      <BuildDateString>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</BuildDateString>
    </PropertyGroup>
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(RepoRoot)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCount" />
      <Output TaskParameter="ExitCode" PropertyName="GitCountExit" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(RepoRoot)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="GitCommitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no -- ." WorkingDirectory="$(RepoRoot)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low"
          Condition="'$(GitCommitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty" />
    </Exec>
    <PropertyGroup>
      <GitCount Condition="'$(GitCountExit)' != '0'">0</GitCount>
      <GitCommit Condition="'$(GitCommitExit)' != '0'">unknown</GitCommit>
      <GitCommit Condition="'$(GitCommitExit)' == '0' And '$(GitDirty)' != ''">$(GitCommit)-dirty</GitCommit>
    </PropertyGroup>
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(BuildInfoHeader)" Overwrite="true"
                      Lines="#pragma once;#define SEQVIEW_VERSION &quot;$(SeqVersion)&quot;;#define SEQVIEW_VERSION_MAJOR $(SeqVersionMajor);#define SEQVIEW_VERSION_MINOR $(SeqVersionMinor);#define SEQVIEW_VERSION_PATCH $(SeqVersionPatch);#define SEQVIEW_BUILD_NUMBER $(GitCount);#define SEQVIEW_GIT_COMMIT &quot;$(GitCommit)&quot;;#define SEQVIEW_BUILD_DATE &quot;$(BuildDateString)&quot;;#define SEQVIEW_BUILD_INFO &quot;$(SeqVersion) (build $(GitCount), $(GitCommit), $(BuildDateString))&quot;" />
    <Message Importance="high" Text="SeqView $(SeqVersion) (build $(GitCount), $(GitCommit), $(BuildDateString))" />
  </Target>
</Project>
