{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip Sequencer",
  "identifier": "dev.clip-sequencer.app",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Ulrich Staudinger",
    "copyright": "Copyright (c) 2026 Ulrich Staudinger",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
